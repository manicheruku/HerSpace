# Application
APP_NAME=HerSpace API
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local development uses SQLite. For production, point this at PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/herspace
DATABASE_URL=sqlite:///./herspace.db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security (used from Phase 2 onwards — replace before production!)
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
